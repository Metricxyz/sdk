{
  "name": "@metric.xyz/metric-omm-sdk-v1",
  "version": "0.5.0",
  "description": "Metric AMM SDK — v1 contracts (SimpleRouter, SwapQuoter, LiquidityAdder, extensions, add/removeLiquidity)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./abis": {
      "import": "./dist/abis/index.js",
      "types": "./dist/abis/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "HOW_TO.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist artifacts cache",
    "init:submodules": "node ./scripts/init-submodules.mjs",
    "sync:contracts": "npx hardhat build --force",
    "sync:abis": "npm run sync:contracts && node ./scripts/sync-abis.mjs",
    "setup:contracts": "npm run init:submodules && npm run sync:abis",
    "pretest": "npm run init:submodules",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs}\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\"",
    "sync:versions:env": "node ./scripts/sync-versions-env.mjs",
    "sync:versions:env:check": "node ./scripts/sync-versions-env.mjs --check",
    "verify": "node ./scripts/verify.mjs",
    "prepublishOnly": "npm run verify && npm run clean && npm run build"
  },
  "keywords": [
    "metric",
    "omm",
    "dex",
    "ethereum",
    "viem",
    "sdk",
    "defi"
  ],
  "author": "Nradko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Metric-OMM/metric-sdk.git"
  },
  "metricPeripheryRef": "6bb01830399a18c559067d53b73c749d89d7bd8d",
  "dependencies": {
    "viem": "^2.x"
  },
  "peerDependencies": {
    "viem": "^2.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.7",
    "@nomicfoundation/hardhat-viem": "^3.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "hardhat": "^3.0.17",
    "prettier": "^3.8.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.58.0"
  }
}